# =========================================================================
# VeriFund AI - Backend Environment Variables
# =========================================================================
# Rename this file to `.env` and fill in the values below.

# -------------------------------------------------------------------------
# Security (JWT Authentication)
# -------------------------------------------------------------------------
# Description: Used to cryptographically sign the JSON Web Tokens.
# How to get it: You can generate a random secure string. 
# (Note: I already generated a random one in your actual .env file)
SECRET_KEY="replace-with-a-secure-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# -------------------------------------------------------------------------
# Relational Database (NeonDB / PostgreSQL)
# -------------------------------------------------------------------------
# Description: Connection string to your Postgres database.
# How to get it: 
#   1. Go to https://neon.tech/ and create a project.
#   2. Copy the connection string from the dashboard.
DATABASE_URL="postgresql://[user]:[password]@[endpoint].neon.tech/verifund?sslmode=require"

# -------------------------------------------------------------------------
# Vector Database (Pinecone)
# -------------------------------------------------------------------------
# Description: Credentials for the semantic vector search database.
# How to get it:
#   1. Go to https://www.pinecone.io/ and create an account.
#   2. Create an index named 'verifund-index' with dimension 384 (because 'all-MiniLM-L6-v2' outputs 384d vectors).
#   3. Copy your API Key and Environment from the Pinecone dashboard.
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="your-pinecone-environment-region"
PINECONE_INDEX_NAME="verifund-index"

# -------------------------------------------------------------------------
# External APIs (Generative AI)
# -------------------------------------------------------------------------
# Description: API Key for the LLM that generates the final responses and summaries.
#   1. Go to Google AI Studio (aistudio.google.com).
#   2. Generate an API Key for Gemini 1.5.
GEMINI_API_KEY="your-gemini-api-key"

# Description: Optional. Used for advanced financial table extraction.
# How to get it:
#   1. Go to cloud.llamaindex.ai and generate an API key.
LLAMA_CLOUD_API_KEY=""

# -------------------------------------------------------------------------
# Object Storage (Neon / AWS S3)
# -------------------------------------------------------------------------
# Description: Used to store uploaded documents securely.
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_ENDPOINT_URL_S3="your-s3-endpoint-url"
AWS_REGION="us-east-2"
